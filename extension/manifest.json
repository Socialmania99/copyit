{
  "manifest_version": 3,
  "name": "Copyit",
  "version": "1.1.0",
  "minimum_chrome_version": "109",
  "description": "Clipboard history. Save text, links, code and images, click to copy, copy text from images, search and back up locally.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "clipboardRead",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Copyit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Copyit"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_page": "settings.html"
}